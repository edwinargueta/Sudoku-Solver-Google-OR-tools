# Copy to .env and edit. Every key is prefixed SUDOKU_ (see app/config.py).

# Origins allowed to call the API — JSON list. Vite dev server by default.
SUDOKU_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Seconds CP-SAT gets for a single request.
SUDOKU_SOLVER_TIME_LIMIT_S=10.0

# Search workers used for a single-solution solve.
SUDOKU_SOLVER_WORKERS=8
