# Copy to .env.local to override. Vite only exposes VITE_-prefixed keys.

# Where the API lives. Leave as /api to use the dev-server proxy in vite.config.ts.
VITE_API_BASE_URL=/api

# Where that proxy forwards to.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Where the footer's "API docs" link points.
VITE_API_DOCS_URL=http://127.0.0.1:8000/docs
